# RippleGate environment template - harmless synthetic placeholders only.
# Copy to .env for local runs. NEVER commit a real .env or real tokens.

# --- core runtime ---
APP_ENV=local
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# --- persistence (PostgreSQL authoritative; Redis queue only) ---
DATABASE_URL=postgres://ripplegate:ripplegate@localhost:5432/ripplegate
REDIS_URL=redis://localhost:6379/0

# --- signing secrets: generate locally, e.g.
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48
SESSION_SIGNING_SECRET=change-me-locally-generated-secret
WEBHOOK_SECRET=change-me-locally-webhook-secret

# --- GitHub identity (owner/repo the deployment is scoped to) ---
GITHUB_OWNER=etalyahsimpson
GITHUB_REPO=ripplegate
GITHUB_INTEGRATION_MODE=actions
# Optional GitHub App mode requires its own credentials; leave unset otherwise.
# GITHUB_APP_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=

# --- controlled test runner ---
RUNNER_MODE=local-launcher
RUNNER_ALLOWED_SUITES=billing-contract,reporting-contract
MAX_RUN_SECONDS=120

# --- artifacts and limits ---
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_DIR=/var/lib/ripplegate/artifacts
MAX_OPENAPI_BYTES=1048576

# --- optional integrations (leave unset unless actually configured) ---
CLOUD_ARTIFACTS_ENABLED=false
# AWS_S3_BUCKET=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
